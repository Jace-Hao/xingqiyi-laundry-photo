        android:pivotY="54"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <!-- 衬衫主体 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M46,28 L38,32 L30,34 L24,48 L34,54 L34,86 L74,86 L74,54 L84,48 L78,34 L70,32 L62,28 C62,36 58,40 54,40 C50,40 46,36 46,28 Z" />

        <!-- 口袋：呼应「衣物照片系统」的存档语义，同时让图标在小尺寸下仍有辨识点 -->
        <path
            android:fillColor="#165DFF"
            android:pathData="M44,56 h20 v14 h-20 z" />
    </group>
</vector>
