<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动主题：使用 androidx.core.splashscreen 的兼容实现，
      postSplashScreenTheme 会在 installSplashScreen() 之后切回正式主题，
      避免启动瞬间的白屏/黑屏闪烁。
    -->
    <style name="Theme.Xingqiyi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Xingqiyi</item>
    </style>

    <!--
      正式主题：仅负责窗口背景与系统栏，页面配色全部交给 Compose Material3 处理。
      状态栏设为透明，让 Compose 内容延伸到状态栏下方（edge-to-edge）。
    -->
    <style name="Theme.Xingqiyi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
