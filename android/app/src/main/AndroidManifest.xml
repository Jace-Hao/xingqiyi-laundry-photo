<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：服务端是局域网内的桌面端，必须联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 弱网/离线判定需要主动查询网络状态，而不是仅靠请求失败推断 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 拍照录入（拍照账号/系统管理员可用；查询类角色不会触发申请） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 8.0+ 通知必须走渠道；离线补传、强制更新、被顶下线都依赖通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 大照片上传可能超过普通后台任务的时长限制，需要前台服务权限（Android 14+ 须声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 相机并非所有角色都需要（查询账号只用查询），声明为可选避免商店按硬件过滤设备 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".LaundryApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Xingqiyi.Splash"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!--
          usesCleartextTraffic=true 是必需的：桌面端服务端是纯 HTTP（http://<内网IP>:17521），
          而 targetSdk 28+ 默认禁止明文流量。服务端仅在内网使用且不承载敏感凭据以外的明文，
          连接码与会话令牌走自定义请求头。若部署环境要求全站 HTTPS，
          可在服务端前加反代并把此处改回 false（见 README「安全建议」）。
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="userPortrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Xingqiyi.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider：把下载到应用私有目录的照片以 content:// URI 分享出去。
          不申请任何存储权限即可把照片发给微信/存进相册，兼容 Android 8 ~ 14 全部版本。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
